# Supabase — Dashboard → Settings → API
# `.venv` (Python 3.12 + supabase>=2.31) ile hem yeni `sb_secret_...`
# anahtarları hem eski JWT `service_role` anahtarları çalışır.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_KEY=sb_secret_...

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OKX → Trade → Demo Trading → Personal Center → Demo Trading API
# Yalnız Trade ve Read yetkileri verin. Withdrawal yetkisi vermeyin.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Hesabınızın bölgesi: Türkiye için tr.okx.com, global hesaplar için openapi.okx.com
OKX_API_BASE_URL=https://tr.okx.com
OKX_SIMULATED_TRADING=1

# Bot kayıtları varsayılan olarak backend/data altında yerel SQLite'ta tutulur.
BOT_DB_PATH=/app/data/nexus_bot.sqlite3

# --- Public demo deployment ---
# Each browser gets an isolated in-memory paper account (no sign-up needed).
ALLOW_GUEST=false
# Bots are global background tasks; set false on public demos.
BOT_CONTROL=true
# memory | supabase
PERSISTENCE=memory
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# REQUIRE_AUTH=true makes Supabase login mandatory (guests are rejected unless ALLOW_GUEST=true)
REQUIRE_AUTH=false
